[{"week":2,"text":"아","image":"01 아.png","audio":"","type":"word"},{"week":2,"text":"야","image":"01 야.png","audio":"","type":"word"},{"week":2,"text":"아이","image":"01 아이.png","audio":"","type":"word"},{"week":2,"text":"사자","image":"01 사자.png","audio":"","type":"word"},{"week":2,"text":"야구","image":"01 야구.png","audio":"","type":"word"},{"week":2,"text":"아야","image":"01 아야.png","audio":"","type":"word"},{"week":2,"text":"약","image":"01 약.png","audio":"","type":"word"},{"week":2,"text":"우리 야구하러 가자","image":"01 우리 야구하러 가자.png","audio":"","type":"sentence"},{"week":2,"text":"안녕하세요","image":"01 안녕하세요.jpg","audio":"","type":"sentence"},{"week":2,"text":"감사합니다","image":"01 감사합니다.png","audio":"","type":"sentence"},{"week":2,"text":"아이가 꿈을 꾸고 있어요.\n아이는 꿈에서 사자를 만났어요\n\"사자야, 우리 야구하러 가자.”\n“그래, 야구하자.”","image":"story 04-01.png","audio":"","type":"story"},{"week":2,"text":"아이와 사자가 운동장에서 \n신나게 야구를 했어요.\n\"사자야, 야구공을 던져 줘.\"","image":"story 04-02.png","audio":"","type":"story"},{"week":2,"text":"“아야! 다리가 아파.” \n아이가 넘어졌어요.","image":"story 04-03.png","audio":"","type":"story"},{"week":2,"text":"“괜찮아? 집에 가서 약을 바르자.” \n사자가 말했어요.","image":"story 04-04.png","audio":"","type":"story"},{"week":2,"text":"\"사자랑 야구를 해서 정말 즐거웠어요. \n또 하고 싶어요.\"","image":"story 04-05.png","audio":"","type":"story"},{"week":3,"text":"어","image":"05 어.png","audio":"","type":"word"},{"week":3,"text":"여","image":"05 여.png","audio":"","type":"word"},{"week":3,"text":"어부","image":"05 어부.png","audio":"","type":"word"},{"week":3,"text":"어항","image":"","audio":"","type":"word"},{"week":3,"text":"여우","image":"","audio":"","type":"word"},{"week":3,"text":"여름","image":"","audio":"","type":"word"},{"week":3,"text":"여우 가족이 바다에 놀러갔어요.","image":"","audio":"","type":"sentence"},{"week":3,"text":"어부는 여우에게 물고기를 주었어요.","image":"","audio":"","type":"sentence"},{"week":3,"text":"더운 여름날\n여우 가족이 바다에 놀러갔어요.\n\"수영은 너무 재밌어.\"","image":"","audio":"","type":"story"},{"week":3,"text":"바다에서는 어부가 물고기를 잡고 있었어요. \n\"물고기를 기르고 싶어요.\"\n어부는 아기 여우에게 물고기를 주었어요.","image":"","audio":"","type":"story"},{"week":3,"text":"아기 여우는 어항 속에 \n물고기를 넣었어요. \n\"물고기가 정말 예쁘다.\"","image":"","audio":"","type":"story"},{"week":"","text":"","image":"","audio":"","type":""},{"week":"","text":"","image":"","audio":"","type":""},{"week":3,"text":"엄마","image":"02 엄마.jpg","audio":"","type":"word"},{"week":3,"text":"아빠","image":"02 아빠.jpg","audio":"","type":"word"},{"week":3,"text":"형","image":"02 형.jpg","audio":"","type":"word"},{"week":4,"text":"하나","image":"03 하나.jpg","audio":"","type":"word"},{"week":4,"text":"둘","image":"03 둘.jpg","audio":"","type":"word"}]