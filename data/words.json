[{"week":2,"text":"아","image":"01 아.png","audio":"","type":"word"},{"week":2,"text":"야","image":"01 야.png","audio":"","type":"word"},{"week":2,"text":"아이","image":"01 아이.png","audio":"","type":"word"},{"week":2,"text":"사자","image":"01 사자.png","audio":"","type":"word"},{"week":2,"text":"야구","image":"01 야구.png","audio":"","type":"word"},{"week":2,"text":"아야","image":"01 아야.png","audio":"","type":"word"},{"week":2,"text":"약","image":"01 약.png","audio":"","type":"word"},{"week":2,"text":"우리 야구하러 가자","image":"01 우리 야구하러 가자.png","audio":"","type":"sentence"},{"week":2,"text":"안녕하세요","image":"01 안녕하세요.jpg","audio":"","type":"sentence"},{"week":2,"text":"감사합니다","image":"01 감사합니다.png","audio":"","type":"sentence"},{"week":2,"text":"아이가 꿈을 꾸고 있어요.\r\n아이는 꿈에서 사자를 만났어요\r\n\"사자야, 우리 야구하러 가자.”\r\n“그래, 야구하자.”","image":"story 04-01.png","audio":"","type":"story"},{"week":2,"text":"아이와 사자가 운동장에서 신나게 야구를 했어요.\r\n\"사자야, 야구공을 던져 줘.\"","image":"story 04-02.png","audio":"","type":"story"},{"week":2,"text":"“아야! 다리가 아파.” 아이가 넘어졌어요.","image":"story 04-03.png","audio":"","type":"story"},{"week":2,"text":"“괜찮아? 집에 가서 약을 바르자.” 사자가 말했어요.","image":"story 04-04.png","audio":"","type":"story"},{"week":2,"text":"\"사자랑 야구를 해서 정말 즐거웠어요. 또 하고 싶어요.\"","image":"story 04-05.png","audio":"","type":"story"},{"week":"","text":"","image":"","audio":"","type":""},{"week":"","text":"","image":"","audio":"","type":""},{"week":3,"text":"엄마","image":"02 엄마.jpg","audio":"","type":"word"},{"week":3,"text":"아빠","image":"02 아빠.jpg","audio":"","type":"word"},{"week":3,"text":"형","image":"02 형.jpg","audio":"","type":"word"},{"week":4,"text":"하나","image":"03 하나.jpg","audio":"","type":"word"},{"week":4,"text":"둘","image":"03 둘.jpg","audio":"","type":"word"}]